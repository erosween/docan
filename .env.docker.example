APP_NAME=Docan
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

# Leave empty on first boot. The entrypoint creates and persists a secure key.
APP_KEY=

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=docan
DB_USERNAME=docan
DB_PASSWORD=replace-with-a-strong-password
DB_SSLMODE=disable

SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=false
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

SEED_DATABASE=false
RUN_MIGRATIONS=true
OPTIMIZE_APP=true

APP_REPLICAS=2
QUEUE_REPLICAS=2
APP_MEMORY_LIMIT=768M
QUEUE_MEMORY_LIMIT=512M
SCHEDULER_MEMORY_LIMIT=256M

APP_STORAGE_VOLUME_NAME=docan_app_storage
POSTGRES_VOLUME_NAME=docan_postgres_data
REDIS_VOLUME_NAME=docan_redis_data
